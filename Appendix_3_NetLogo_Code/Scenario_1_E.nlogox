  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="Interconnectivity experiment (H4)" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="2000">
      <setup>setup</setup>
      <go>go</go>
      <runMetricsCondition>ticks mod 100 = 0</runMetricsCondition>
      <metrics>
        <metric>run-seed</metric>
        <metric>households</metric>
        <metric>livestock</metric>
        <metric>gini-wealth</metric>
        <metric>gini-herds</metric>
        <metric>mean-gini-wealth</metric>
        <metric>mean-gini-herds</metric>
        <metric>gini-first-500</metric>
        <metric>gini-last-500</metric>
        <metric>gini-peak</metric>
        <metric>gini-peak-year</metric>
        <metric>half-gone-year</metric>
        <metric>dissolved-households</metric>
        <metric>persistence-25-wealth</metric>
        <metric>persistence-25-herds</metric>
        <metric>persistence-200-wealth</metric>
        <metric>persistence-200-herds</metric>
        <metric>disaster-loss-share</metric>
        <metric>number-of-networks</metric>
        <metric>number-of-clients</metric>
        <metric>largest-network</metric>
        <metric>mean-network-size</metric>
        <metric>mean-number-of-networks</metric>
        <metric>mean-largest-network</metric>
        <metric>mean-network-size-run</metric>
        <metric>mean-network-duration</metric>
        <metric>share-of-open-networks</metric>
        <metric>mean-contract-length</metric>
        <metric>returns-to-dependence</metric>
        <metric>exits-forced-change</metric>
        <metric>exits-status-loss</metric>
        <metric>exits-dissolution</metric>
        <metric>patron-crisis-survival</metric>
        <metric>patron-herd-change</metric>
        <metric>patron-wealth-change</metric>
        <metric>mean-patron-herd</metric>
        <metric>mean-patron-wealth</metric>
        <metric>patron-gap-herd</metric>
        <metric>patron-gap-wealth</metric>
        <metric>networks-observed</metric>
        <metric>recipient-loss-share</metric>
        <metric>other-loss-share</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-of-households">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-herd">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="carrying-capacity">
          <value value="25000"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="growth-rate">
          <value value="0.1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="individual-disaster-rate">
          <value value="0.1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="general-disaster-rate">
          <value value="0.1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="general-disaster-hit">
          <value value="0.4"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="loss-rate">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="dissolution-threshold">
          <value value="2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="poverty-threshold">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="patron-threshold">
          <value value="500"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="help-threshold">
          <value value="500"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="fixed-transfer">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="patron-choice">
          <value value="&quot;random&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="max-years">
          <value value="2000"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="warm-up">
          <value value="300"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="fixed-seed">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="inflow-level">
          <value value="0.015"></value>
          <value value="0.03"></value>
          <value value="0.06"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="channel">
          <value value="&quot;top&quot;"></value>
          <value value="&quot;frontier&quot;"></value>
          <value value="&quot;diffuse&quot;"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
