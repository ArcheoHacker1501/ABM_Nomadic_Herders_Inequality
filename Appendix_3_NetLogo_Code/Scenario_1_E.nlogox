<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; ============================================================================
;; Capital Conversion, Debt and Interconnectivity: A Formal Approach to
;; Inequality among Nomadic Herders in Ancient Eurasia
;; Agent-based model. Scenario 1+E (S1+E): gifts to households in need, with
;; external resources. Tests H4 (interconnectivity), compared with
;; Scenario 1; reference for Scenario 3+E.
;; ============================================================================

globals [
  ;; parameters (default values in set-parameters)
  number-of-households       ; households at the start
  initial-herd               ; animals of each household at the start
  carrying-capacity          ; total animals that the pastures can support
  growth-rate                ; yearly growth of each herd
  individual-disaster-rate   ; yearly probability of an individual disaster
  general-disaster-rate      ; yearly probability of a general disaster
  general-disaster-hit       ; probability that a general disaster strikes a household
  loss-rate                  ; share of the herd lost in a disaster
  dissolution-threshold      ; below this herd a household that no patron can help dissolves
  poverty-threshold          ; below this herd a household asks for help
  help-threshold             ; herd that a household must keep after giving or lending animals
  patron-threshold           ; herd below which a patron loses his status
  fixed-transfer             ; 0 = only the animals needed; otherwise at least this number of head
  patron-choice              ; "random" or "richest"
  inflow-level               ; yearly inflow of external goods, as a share of the carrying capacity
  channel                    ; "top", "frontier" or "diffuse"
  max-years                  ; length of a run
  warm-up                    ; first years excluded from the run measures
  fixed-seed                 ; 0 = a new random seed at every setup
  ;; state of the run
  run-seed                   ; random seed of the current run
  current-patrons            ; households with at least one active client
  crisis-patrons             ; patrons at the time of this year's general disaster
  ;; measures, recorded over the years after the warm-up (see the reporters)
  years-measured
  gini-wealth-sum            ; Gini of total wealth, summed over the years
  gini-herds-sum             ; Gini of the herds kept, summed over the years
  gini-first-sum             ; Gini of total wealth in the first 500 years after the warm-up
  gini-first-years
  gini-last-sum              ; Gini of total wealth in the last 500 years of the run
  gini-last-years
  gini-peak                  ; highest yearly Gini of total wealth, and its year
  gini-peak-year
  half-gone-year             ; year in which half of the households had disappeared (-1 = never)
  top-wealth-history         ; richest 10% by total wealth in each of the last 25 years
  top-herds-history          ; the same, by herd kept
  top-wealth-sizes           ; size of the richest 10% in every year, by total wealth
  top-herds-sizes            ; the same, by herd kept
  retention-wealth           ; shares of the richest 10% still among them after 25 years
  retention-herds
  continuity-wealth          ; shares of the richest 10% among them without interruption for 200 years
  continuity-herds
  networks-sum               ; number of networks, summed over the years
  largest-network-sum        ; clients of the largest network, summed over the years
  network-size-sum           ; mean network size, summed over the years with networks
  network-years              ; years with at least one network
  patron-spells              ; durations of the networks, completed or open at the end
  open-spells                ; networks still active at the end of the run
  contract-lengths           ; durations of the relationships that ended
  exits-forced-change        ; relationships ended because the client found a new patron
  exits-status-loss          ; relationships ended because the patron lost his status
  exits-dissolution          ; relationships ended because the client dissolved
  returns-to-dependence      ; former clients that found a patron again
  crisis-survival            ; shares of the crisis patrons still patrons at the end of the year
  herd-change-sum            ; yearly relative changes of the direct herd of the patrons
  wealth-change-sum          ; yearly relative changes of the total wealth of the patrons
  change-count
  dissolved-households
  losses                     ; animals lost in disasters, net of any replacement
  herds-struck               ; herds of the households struck, before the disaster
  recipient-losses           ; the same for the recipients of external goods
  recipient-herds-struck
  other-losses               ; and for the other households
  other-herds-struck
]

turtles-own [
  herd                ; animals of the household
  my-patron           ; the patron of the household, or nobody
  contract-start      ; year in which the current relationship began
  former-client?      ; true if the household has already been a client
  patron-spell        ; consecutive years with at least one active client
  previous-herd       ; direct herd at the end of last year, if then a patron (else 0)
  previous-wealth     ; total wealth at the end of last year, if then a patron (else 0)
  consumables         ; external goods usable only in the year they arrive
  frontier?           ; true for the quarter of frontier households
  recipient?          ; true if the household received goods this year
  top-spell-wealth    ; consecutive years in the richest 10% by total wealth
  top-spell-herds     ; consecutive years in the richest 10% by herd kept
]

;; ---------------------------------------------------------------------- setup

to set-defaults
  ;; gives every parameter its default value
  set-parameters true
end

to set-parameters [ reset-all? ]
  ;; default values of the parameters. With reset-all? false, as in setup,
  ;; only the parameters still equal to 0 (never set) take their default
  ;; value, so a value given before setup in the Command Center or in
  ;; BehaviorSpace is kept. A parameter that must be 0 cannot be given before
  ;; setup: set it after setup (for example "setup set general-disaster-rate 0")
  set number-of-households chosen-value reset-all? number-of-households 100
  set initial-herd chosen-value reset-all? initial-herd 60
  ;; 10,000 and 50,000 in the sensitivity analysis
  set carrying-capacity chosen-value reset-all? carrying-capacity 25000
  set growth-rate chosen-value reset-all? growth-rate 0.10
  ;; 0.10 in the experiment with external resources
  set individual-disaster-rate chosen-value reset-all? individual-disaster-rate 0.10
  set general-disaster-rate chosen-value reset-all? general-disaster-rate 0.10
  set general-disaster-hit chosen-value reset-all? general-disaster-hit 0.40
  set loss-rate chosen-value reset-all? loss-rate 0.50
  set dissolution-threshold chosen-value reset-all? dissolution-threshold 2
  set poverty-threshold chosen-value reset-all? poverty-threshold 60
  set patron-threshold chosen-value reset-all? patron-threshold 500
  ;; never below patron-threshold
  set help-threshold chosen-value reset-all? help-threshold 500
  ;; 0 = the animals needed to get back to the poverty threshold
  set fixed-transfer chosen-value reset-all? fixed-transfer 0
  ;; "random" or "richest"
  set patron-choice chosen-value reset-all? patron-choice "random"
  if not member? patron-choice ["random" "richest"] [ error "patron-choice must be random or richest" ]
  if help-threshold < patron-threshold [ error "help-threshold must not be below patron-threshold" ]
  ;; 0.015, 0.03 or 0.06 of the carrying capacity per year
  set inflow-level chosen-value reset-all? inflow-level 0.03
  ;; "top", "frontier" or "diffuse"
  set channel chosen-value reset-all? channel "top"
  if not member? channel ["top" "frontier" "diffuse"] [ error "channel must be top, frontier or diffuse" ]
  set max-years chosen-value reset-all? max-years 2000
  set warm-up chosen-value reset-all? warm-up 300
  set fixed-seed chosen-value reset-all? fixed-seed 0
end

to-report chosen-value [ reset-all? current-value default-value ]
  report ifelse-value (reset-all? or current-value = 0) [ default-value ] [ current-value ]
end

to setup
  ;; the parameters are not cleared, so that values chosen before setup are kept
  clear-turtles
  clear-patches
  clear-drawing
  clear-all-plots
  clear-output
  set-parameters false
  reset-measures
  ifelse fixed-seed = 0 [ set run-seed new-seed ] [ set run-seed fixed-seed ]
  random-seed run-seed
  create-turtles number-of-households [
    setxy random-xcor random-ycor
    set shape "circle"
    set herd initial-herd
    set my-patron nobody
    set contract-start 0
    set former-client? false
    set patron-spell 0
    set previous-herd 0
    set previous-wealth 0
    set consumables 0
    set frontier? false
    set recipient? false
    set top-spell-wealth 0
    set top-spell-herds 0
  ]
  ;; the frontier households are a quarter of all households, drawn once
  ask n-of (round (number-of-households / 4)) turtles [ set frontier? true ]
  update-display
  reset-ticks
end

to reset-measures
  set current-patrons no-turtles
  set crisis-patrons no-turtles
  set years-measured 0
  set gini-wealth-sum 0
  set gini-herds-sum 0
  set gini-first-sum 0
  set gini-first-years 0
  set gini-last-sum 0
  set gini-last-years 0
  set gini-peak 0
  set gini-peak-year 0
  set half-gone-year -1
  set top-wealth-history []
  set top-herds-history []
  set top-wealth-sizes []
  set top-herds-sizes []
  set retention-wealth []
  set retention-herds []
  set continuity-wealth []
  set continuity-herds []
  set networks-sum 0
  set largest-network-sum 0
  set network-size-sum 0
  set network-years 0
  set patron-spells []
  set open-spells 0
  set contract-lengths []
  set exits-forced-change 0
  set exits-status-loss 0
  set exits-dissolution 0
  set returns-to-dependence 0
  set crisis-survival []
  set herd-change-sum 0
  set wealth-change-sum 0
  set change-count 0
  set dissolved-households 0
  set losses 0
  set herds-struck 0
  set recipient-losses 0
  set recipient-herds-struck 0
  set other-losses 0
  set other-herds-struck 0
end

;; ------------------------------------------------------------------- one year

to go
  if (ticks >= max-years) or (not any? turtles) [ stop ]
  ;; the operations of one year, numbered as in Appendix 2 (this scenario
  ;; has only those of its own mechanisms); within each of them households
  ;; act one at a time, in random order
  receive-external-goods  ; 1. external goods arrive
  grow-herds              ; 2. growth
  disasters               ; 4. individual and general disasters, and replacement with external goods
  check-patrons           ; 5. loss of patron status
  seek-help               ; 6. households below 60 animals look for help
  dissolve                ; 7. households below 2 animals that no patron can help dissolve
  check-consistency       ; internal checks: an error stops the run if the bookkeeping breaks
  tick
  update-measures         ; 8. the measures of the year
  update-display
end

to run-simulation
  setup
  repeat max-years [ go ]
end

to receive-external-goods
  ;; the yearly inflow, in head of livestock, is a share of the carrying
  ;; capacity, divided in equal shares among the recipients of the channel:
  ;; the richest 10% of the year by total wealth (top), the frontier
  ;; households still present (frontier) or all households (diffuse)
  ask turtles [
    set consumables 0          ; consumables not used in the previous year are lost
    set recipient? false
  ]
  let recipients no-turtles
  if channel = "top" [ set recipients richest-tenth-by-wealth ]
  if channel = "frontier" [ set recipients turtles with [ frontier? ] ]
  if channel = "diffuse" [ set recipients turtles ]
  if any? recipients [
    let portion (inflow-level * carrying-capacity) / (count recipients)
    ask recipients [
      set recipient? true
      set consumables consumables + portion
    ]
  ]
end

to grow-herds
  ;; as in Shultz and Costopoulos (2019: 3, 10), households grow one at a time,
  ;; in random order, while the total livestock does not exceed the carrying
  ;; capacity
  let livestock-now sum [herd] of turtles
  ask turtles [
    if livestock-now <= carrying-capacity [
      let increase herd * growth-rate
      set herd herd + increase
      set livestock-now livestock-now + increase
    ]
  ]
end

to disasters
  ;; every household may suffer an individual disaster; in a year of general
  ;; disaster each household is struck with probability general-disaster-hit;
  ;; a disaster halves the herd, and a household struck by both loses half of
  ;; its herd twice, that is, three quarters
  let general-disaster? random-float 1 < general-disaster-rate
  ;; the patrons at the time of a general disaster (for the crisis measure)
  set crisis-patrons no-turtles
  if general-disaster? [ set crisis-patrons turtles with [ any? my-clients ] ]
  ask turtles [
    let hits 0
    if random-float 1 < individual-disaster-rate [ set hits hits + 1 ]
    if general-disaster? and random-float 1 < general-disaster-hit [ set hits hits + 1 ]
    if hits > 0 [
      let herd-before herd
      let kept (1 - loss-rate) ^ hits
      set herd herd * kept
      ;; the goods replace the animals just lost
      replace-losses (herd-before - herd)
      record-losses herd-before
    ]
  ]
end

to replace-losses [ lost ]
  ;; the external goods replace the animals just lost, at most up to the level
  ;; before the disaster
  let from-consumables min (list consumables lost)
  set consumables consumables - from-consumables
  set herd herd + from-consumables
end

to record-losses [ herd-before ]
  ;; losses net of replacement, for all households and separately for the
  ;; recipients of external goods and for the other households
  if ticks >= warm-up [
    set losses losses + herd-before - herd
    set herds-struck herds-struck + herd-before
    ifelse recipient? [
      set recipient-losses recipient-losses + herd-before - herd
      set recipient-herds-struck recipient-herds-struck + herd-before
    ] [
      set other-losses other-losses + herd-before - herd
      set other-herds-struck other-herds-struck + herd-before
    ]
  ]
end

to check-patrons
  ;; a patron whose herd falls below the patron threshold loses his status
  ;; and all his clients at once, as in Shultz and Costopoulos (2019: 6)
  ask turtle-set [my-patron] of turtles with [ my-patron != nobody ] [
    if herd < patron-threshold [
      ask my-clients [ end-relationship "status loss" ]
    ]
  ]
end

to seek-help
  ;; a household below the poverty threshold asks its patron, if it has one,
  ;; for the animals it needs to get back to the threshold; if the patron
  ;; cannot give them and still keep the help threshold, or if the household
  ;; has no patron, it looks for one among the households that can, chosen at
  ;; random (or the richest of them, in the sensitivity analysis). A client
  ;; that finds one leaves its old patron, while one that finds
  ;; none stays with him, as in the code of Shultz and Costopoulos. No
  ;; household can become the patron of its own patron
  ask turtles with [ herd < poverty-threshold ] [
    let old-patron my-patron
    let helped? false
    if old-patron != nobody [
      let amount transfer-amount herd
      if ([herd] of old-patron) - amount >= help-threshold [
        receive-gift old-patron amount
        set helped? true
      ]
    ]
    if not helped? [
      let herd-after herd
      let amount transfer-amount herd-after
      let candidates other turtles with [
        self != old-patron and my-patron != myself and herd - amount >= help-threshold ]
      if any? candidates [
        ifelse old-patron != nobody [
          end-relationship "forced change"
        ] [
          if former-client? and ticks >= warm-up [
            set returns-to-dependence returns-to-dependence + 1
          ]
        ]
        set my-patron choose-patron candidates
        set contract-start ticks
        receive-gift my-patron amount
      ]
    ]
  ]
end

to-report transfer-amount [ current-herd ]
  ;; the animals needed to bring the herd back to the poverty threshold, or a
  ;; fixed number of head (sensitivity analysis), if larger
  report max (list fixed-transfer (poverty-threshold - current-herd))
end

to-report choose-patron [ candidates ]
  ;; one of the households that can help, at random, or the richest of them by
  ;; total wealth (sensitivity analysis)
  if patron-choice = "richest" [ report max-one-of candidates [ wealth ] ]
  report one-of candidates
end

to receive-gift [ giver amount ]
  ;; a gift creates no obligation and brings the patron no gain
  ask giver [ set herd herd - amount ]
  set herd herd + amount
end

to end-relationship [ reason ]
  ;; the client leaves its patron; the measures record why and after how long
  if ticks >= warm-up [
    if reason = "forced change" [ set exits-forced-change exits-forced-change + 1 ]
    if reason = "status loss" [ set exits-status-loss exits-status-loss + 1 ]
    if reason = "dissolution" [ set exits-dissolution exits-dissolution + 1 ]
    set contract-lengths lput (ticks - contract-start) contract-lengths
  ]
  set my-patron nobody
  set former-client? true
end

to dissolve
  ;; a household still below the dissolution threshold after seek-help is one
  ;; that no patron can help: it dissolves and is removed from the simulation,
  ;; together with its animals, even if it still has a patron
  ask turtles with [ herd < dissolution-threshold ] [
    if any? my-clients [ error "a patron cannot dissolve" ]
    if my-patron != nobody [ end-relationship "dissolution" ]
    if ticks >= warm-up [
      ;; a former patron that lost his status this year closes his network
      if patron-spell > 0 [ set patron-spells lput patron-spell patron-spells ]
      set dissolved-households dissolved-households + 1
    ]
    die
  ]
end

to check-consistency
  ;; internal checks of the bookkeeping, at the end of every year
  if any? turtles with [ herd < -0.000001 ] [ error "a herd is negative" ]
  if any? turtles with [ my-patron != nobody and [my-patron] of my-patron = self ] [
    error "a household is the patron of its own patron"
  ]
  if any? (turtle-set [my-patron] of turtles with [ my-patron != nobody ]) with [ herd < patron-threshold - 0.000001 ] [
    error "a patron is below the patron threshold"
  ]
end

;; ------------------------------------------------------------------- measures

to update-measures
  ;; after tick: ticks is the number of the year just ended. The run measures
  ;; use the years after the warm-up (in S0 and S0+E, all years)
  ;; households remaining: the year in which half of them had disappeared
  if half-gone-year < 0 and count turtles <= number-of-households / 2 [ set half-gone-year ticks ]
  if not any? turtles [ stop ]
  let counted? ticks > warm-up
  set current-patrons turtle-set [my-patron] of turtles with [ my-patron != nobody ]
  ;; economic inequality: Gini of total wealth and of the herds kept
  if counted? [
    let g gini [wealth] of turtles
    set years-measured years-measured + 1
    set gini-wealth-sum gini-wealth-sum + g
    set gini-herds-sum gini-herds-sum + gini [herd] of turtles
    if g > gini-peak [
      set gini-peak g
      set gini-peak-year ticks
    ]
    if ticks <= warm-up + 500 [
      set gini-first-sum gini-first-sum + g
      set gini-first-years gini-first-years + 1
    ]
    if ticks > max-years - 500 [
      set gini-last-sum gini-last-sum + g
      set gini-last-years gini-last-years + 1
    ]
  ]
  update-persistence
  update-networks counted?
  if ticks = max-years [ finish-networks ]
end

to update-persistence
  ;; persistence: share of the richest 10% still among them after 25 years, one
  ;; generation, and share that remain among them without interruption for
  ;; 200 years, by total wealth and, for comparison, by herd kept
  let top-wealth richest-tenth-by-wealth
  let top-herds richest-tenth-by-herd
  ask turtles [
    set top-spell-wealth ifelse-value (member? self top-wealth) [ top-spell-wealth + 1 ] [ 0 ]
    set top-spell-herds ifelse-value (member? self top-herds) [ top-spell-herds + 1 ] [ 0 ]
  ]
  set top-wealth-sizes lput (count top-wealth) top-wealth-sizes
  set top-herds-sizes lput (count top-herds) top-herds-sizes
  ;; 25 years: the histories keep the last 25 sets, so that the set of 25
  ;; years ago is at place (ticks - 1) mod 25; households that dissolved since
  ;; are no longer in it, but the size of the set is kept apart
  ifelse length top-wealth-history < 25 [
    set top-wealth-history lput top-wealth top-wealth-history
    set top-herds-history lput top-herds top-herds-history
  ] [
    let k (ticks - 1) mod 25
    if ticks - 25 > warm-up [
      let kept-wealth count (item k top-wealth-history) with [ member? self top-wealth ]
      set retention-wealth lput (kept-wealth / (item (ticks - 26) top-wealth-sizes)) retention-wealth
      let kept-herds count (item k top-herds-history) with [ member? self top-herds ]
      set retention-herds lput (kept-herds / (item (ticks - 26) top-herds-sizes)) retention-herds
    ]
    set top-wealth-history replace-item k top-wealth-history top-wealth
    set top-herds-history replace-item k top-herds-history top-herds
  ]
  ;; 200 years: a household in the richest 10% for at least 200 years running
  ;; has been among them in every year since the year 199 years ago
  if ticks - 199 > warm-up [
    let base ticks - 199
    set continuity-wealth lput ((count top-wealth with [ top-spell-wealth >= 200 ]) / (item (base - 1) top-wealth-sizes)) continuity-wealth
    set continuity-herds lput ((count top-herds with [ top-spell-herds >= 200 ]) / (item (base - 1) top-herds-sizes)) continuity-herds
  ]
end

to update-networks [ counted? ]
  ;; network duration: consecutive years with at least one active client
  ask turtles [
    ifelse member? self current-patrons [
      set patron-spell patron-spell + 1
    ] [
      if patron-spell > 0 [
        if counted? [ set patron-spells lput patron-spell patron-spells ]
        set patron-spell 0
      ]
    ]
  ]
  if counted? [
    ;; network size: number of networks, size of the largest and mean size
    set networks-sum networks-sum + count current-patrons
    if any? current-patrons [
      set largest-network-sum largest-network-sum + max [count my-clients] of current-patrons
      set network-size-sum network-size-sum + mean [count my-clients] of current-patrons
      set network-years network-years + 1
    ]
    ;; crisis: share of the patrons at the time of this year's general disaster
    ;; still patrons at the end of the year
    if any? crisis-patrons [
      set crisis-survival lput ((count crisis-patrons with [ member? self current-patrons ]) / (count crisis-patrons)) crisis-survival
    ]
    ;; patron wealth: yearly relative change of the direct herd and of total
    ;; wealth of the households that were patrons last year and are still now
    ask current-patrons with [ previous-herd > 0 ] [
      set herd-change-sum herd-change-sum + abs (herd - previous-herd) / previous-herd
      set wealth-change-sum wealth-change-sum + abs (wealth - previous-wealth) / previous-wealth
      set change-count change-count + 1
    ]
  ]
  ask turtles [
    ifelse member? self current-patrons [
      set previous-herd herd
      set previous-wealth wealth
    ] [
      set previous-herd 0
      set previous-wealth 0
    ]
  ]
end

to finish-networks
  ;; at the end of the run, the networks still active are counted with the
  ;; years observed
  ask current-patrons [
    set patron-spells lput patron-spell patron-spells
    set open-spells open-spells + 1
  ]
end

;; Reporters. Yearly values, for monitors, plots and BehaviorSpace runs
;; recorded every few years:

to-report households
  report count turtles
end

to-report livestock                  ; all the animals
  report sum [herd] of turtles
end

to-report gini-wealth                ; economic inequality, on total wealth
  report gini [wealth] of turtles
end

to-report gini-herds                 ; for comparison, on the herds kept
  report gini [herd] of turtles
end

to-report number-of-networks         ; patrons with active clients
  report count turtles with [ any? my-clients ]
end

to-report number-of-clients
  report count turtles with [ my-patron != nobody ]
end

to-report largest-network            ; active clients of the largest network
  let patrons-now turtles with [ any? my-clients ]
  if not any? patrons-now [ report 0 ]
  report max [count my-clients] of patrons-now
end

to-report mean-network-size
  let patrons-now turtles with [ any? my-clients ]
  if not any? patrons-now [ report 0 ]
  report mean [count my-clients] of patrons-now
end

to-report mean-patron-herd           ; patron wealth: direct herd
  let patrons-now turtles with [ any? my-clients ]
  if not any? patrons-now [ report 0 ]
  report mean [herd] of patrons-now
end

to-report mean-patron-wealth         ; patron wealth: direct herd plus lent animals
  let patrons-now turtles with [ any? my-clients ]
  if not any? patrons-now [ report 0 ]
  report mean [wealth] of patrons-now
end

to-report patron-gap-herd            ; richest minus poorest patron, direct herd
  let patrons-now turtles with [ any? my-clients ]
  if not any? patrons-now [ report 0 ]
  report (max [herd] of patrons-now) - (min [herd] of patrons-now)
end

to-report patron-gap-wealth          ; richest minus poorest patron, total wealth
  let patrons-now turtles with [ any? my-clients ]
  if not any? patrons-now [ report 0 ]
  report (max [wealth] of patrons-now) - (min [wealth] of patrons-now)
end

to-report patron-records             ; each patron: [who, direct herd, total wealth, clients]
  report [ (list who herd wealth (count my-clients)) ] of turtles with [ any? my-clients ]
end

;; Run values: means over the years after the warm-up (in S0 and S0+E, all
;; years), to be recorded at the end of each run. A value that is not
;; defined in a run, for example the mean network duration when no
;; network was observed, is reported as "NA"

to-report mean-gini-wealth
  report safe-ratio gini-wealth-sum years-measured
end

to-report mean-gini-herds
  report safe-ratio gini-herds-sum years-measured
end

to-report gini-first-500             ; first 500 years after the warm-up
  report safe-ratio gini-first-sum gini-first-years
end

to-report gini-last-500              ; last 500 years of the run
  report safe-ratio gini-last-sum gini-last-years
end

to-report persistence-25-wealth      ; used in the criteria of the hypotheses
  report safe-mean retention-wealth
end

to-report persistence-25-herds
  report safe-mean retention-herds
end

to-report persistence-200-wealth     ; comparison with Tamir
  report safe-mean continuity-wealth
end

to-report persistence-200-herds
  report safe-mean continuity-herds
end

to-report disaster-loss-share        ; share of the herds struck lost, net of replacement
  report safe-ratio losses herds-struck
end

to-report recipient-loss-share       ; losses of recipients
  report safe-ratio recipient-losses recipient-herds-struck
end

to-report other-loss-share           ; losses of the other households
  report safe-ratio other-losses other-herds-struck
end

to-report mean-number-of-networks
  report safe-ratio networks-sum years-measured
end

to-report mean-largest-network
  report safe-ratio largest-network-sum years-measured
end

to-report mean-network-size-run      ; years with at least one network
  report safe-ratio network-size-sum network-years
end

to-report networks-observed          ; networks ended after the warm-up or open at the end
  report length patron-spells
end

to-report mean-network-duration      ; includes the networks open at the end
  report safe-mean patron-spells
end

to-report share-of-open-networks     ; networks still active at the end
  report safe-ratio open-spells (length patron-spells)
end

to-report mean-contract-length
  report safe-mean contract-lengths
end

to-report patron-crisis-survival     ; patrons keeping their status in a general disaster
  report safe-mean crisis-survival
end

to-report patron-herd-change         ; mean yearly relative change, direct herd
  report safe-ratio herd-change-sum change-count
end

to-report patron-wealth-change       ; mean yearly relative change, total wealth
  report safe-ratio wealth-change-sum change-count
end

;; Helpers

to-report wealth                     ; turtle reporter: total wealth (no loans here)
  report herd
end

to-report my-clients                 ; turtle reporter: the active clients
  report turtles with [ my-patron = myself ]
end

to-report richest-tenth-by-wealth
  report max-n-of (max (list 1 (round (0.1 * count turtles)))) turtles [ wealth ]
end

to-report richest-tenth-by-herd
  report max-n-of (max (list 1 (round (0.1 * count turtles)))) turtles [ herd ]
end

to-report gini [ values ]
  let n length values
  let total sum values
  if n = 0 or total <= 0 [ report 0 ]
  let sorted-values sort values
  let weighted 0
  let i 0
  repeat n [
    set weighted weighted + (i + 1) * (item i sorted-values)
    set i i + 1
  ]
  report (2 * weighted) / (n * total) - (n + 1) / n
end

to-report safe-mean [ values ]       ; "NA" if there is nothing to average
  report ifelse-value (empty? values) [ "NA" ] [ mean values ]
end

to-report safe-ratio [ a b ]         ; "NA" if the denominator is 0
  report ifelse-value (b = 0) [ "NA" ] [ a / b ]
end

;; -------------------------------------------------------------------- display

to update-display
  ;; red = patron, sky = client, gray = other household; size grows with the herd
  ask turtles [
    set color ifelse-value (member? self current-patrons) [ red ]
      [ ifelse-value (my-patron != nobody) [ sky ] [ gray ] ]
    set size 0.5 + (ln (1 + herd)) / 3
  ]
end
]]></code>
